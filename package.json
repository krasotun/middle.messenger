{
  "name": "middle.messenger",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run lint && npm run lint:styles && vite build",
    "preview": "vite preview",
    "start": " rm -rf dist && npm run build && npm run preview",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier \"**/*.{js,mjs,cjs,ts,mts,cts,css,html,md,json}\" --write"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^8.57.0",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@yoichiro/vite-plugin-handlebars": "^1.4.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "postcss-nested": "^7.0.2",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-checker": "^0.10.2"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "uuid": "^13.0.0"
  }
}
