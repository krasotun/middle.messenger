<div class="input{{#if isInvalid}} input__invalid{{/if}}">
  <label class="input__label" for="{{ name }}">{{ label }}</label>
  <input
    class="input__control"
    data-event-target="input"
    type="{{ type }}"
    id="{{ name }}"
    name="{{ name }}"
    value="{{ value }}"
    placeholder="{{ placeholder }}"
    {{#if disabled}}disabled="disabled"{{/if}}
  >
  {{#if isInvalid}}
    <div class="input__error">Не валиден</div>
  {{/if}}
