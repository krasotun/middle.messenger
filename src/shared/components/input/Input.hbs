<div class="input{{#unless isValid}} input__invalid{{/unless}}">
  {{#if label}}<label class="input__label" for="{{ name }}">{{ label }}</label>{{/if}}
  <input
    class="input__control"
    data-event-target="input"
    type="{{ type }}"
    id="{{ name }}"
    name="{{ name }}"
    {{#unless isFile}}value="{{ value }}"{{/unless}}
    placeholder="{{ placeholder }}"
    {{#if disabled}}disabled="disabled"{{/if}}
  >
  <div class="input__error">{{#unless isValid}}{{ errorMessage }}{{/unless}}</div>
