<section class="error">
    <div class="error__content">
        <div class="error__code">{{ code }}</div>
        <h1 class="error__title">{{ title }}</h1>
        <p class="error__text">{{ text }}</p>
        <div class="error__actions">
            <a class="error__link" href="{{ linkHref }}">{{ linkTitle }}</a>
        </div>
    </div>
</section>
