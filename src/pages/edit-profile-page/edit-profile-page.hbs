<section class="auth auth--edit-profile">
    <form class="auth__form" action="#" method="post">
        <h1 class="auth__title">Настройки пользователя</h1>
        <div class="auth__field">
            <label class="auth__label" for="first_name">Имя</label>
            <input class="auth__input" type="text" id="first_name" name="first_name">
        </div>
        <div class="auth__field">
            <label class="auth__label" for="second_name">Фамилия</label>
            <input class="auth__input" type="text" id="second_name" name="second_name">
        </div>
        <div class="auth__field">
            <label class="auth__label" for="display_name">Отображаемое имя</label>
            <input class="auth__input" type="text" id="display_name" name="display_name">
        </div>
        <div class="auth__field">
            <label class="auth__label" for="login">Логин</label>
            <input class="auth__input" type="text" id="login" name="login">
        </div>
        <div class="auth__field">
            <label class="auth__label" for="email">Почта</label>
            <input class="auth__input" type="email" id="email" name="email">
        </div>
        <div class="auth__field">
            <label class="auth__label" for="phone">Телефон</label>
            <input class="auth__input" type="tel" id="phone" name="phone">
        </div>
        <div class="auth__field">
            <label class="auth__label" for="avatar">Аватар</label>
            <input class="auth__input" type="file" id="avatar" name="avatar" accept="image/*">
        </div>
        <div class="auth__field">
            <label class="auth__label" for="oldPassword">Старый пароль</label>
            <input class="auth__input" type="password" id="oldPassword" name="oldPassword">
        </div>
        <div class="auth__field">
            <label class="auth__label" for="newPassword">Новый пароль</label>
            <input class="auth__input" type="password" id="newPassword" name="newPassword">
        </div>
        <div class="auth__actions">
            <button class="auth__button" type="submit">Сохранить</button>
            <button class="auth__button auth__button--secondary" type="button">Отменить изменения</button>
        </div>
    </form>
</section>
