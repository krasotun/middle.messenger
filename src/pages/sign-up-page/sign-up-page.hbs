<section class="auth auth--sign-up">
    <form class="auth__form" action="#" method="post">
        <h1 class="auth__title">Регистрация</h1>
        <div class="auth__field">
            <label class="auth__label" for="first_name">Имя</label>
            <input class="auth__input" type="text" id="first_name" name="first_name">
        </div>
        <div class="auth__field">
            <label class="auth__label" for="second_name">Фамилия</label>
            <input class="auth__input" type="text" id="second_name" name="second_name">
        </div>
        <div class="auth__field">
            <label class="auth__label" for="login">Логин</label>
            <input class="auth__input" type="text" id="login" name="login">
        </div>
        <div class="auth__field">
            <label class="auth__label" for="email">Почта</label>
            <input class="auth__input" type="email" id="email" name="email">
        </div>
        <div class="auth__field">
            <label class="auth__label" for="password">Пароль</label>
            <input class="auth__input" type="password" id="password" name="password">
        </div>
        <div class="auth__field">
            <label class="auth__label" for="phone">Телефон</label>
            <input class="auth__input" type="tel" id="phone" name="phone">
        </div>
        <button class="auth__button" type="submit">Зарегистрироваться</button>
        <a class="auth__link" href="/sign-in">Есть аккаунт? Войти</a>
    </form>
</section>
