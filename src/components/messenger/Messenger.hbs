<section class="messenger">
    <aside class="messenger__sidebar">
    {{{ addChatForm }}}
    {{#if activeChat}}
        {{{ addUserToChatForm }}}
        {{{ removeUserFromChatForm }}}
    {{/if}}
        <h1 class="messenger__title">Чаты</h1>
    {{{ chatList }}}
    <div class="messenger__sidebar-footer">
        {{{ changePasswordButton }}}
        {{{ changeAvatarButton }}}
        {{{ editProfileButton }}}
        {{{ logoutButton }}}
    </div>
</aside>
    <div class="messenger__chat">
        {{#if activeChat}}
            {{{ chatHeader }}}
        {{/if}}
        {{{ messages }}}
        {{{ sendMessageForm }}}
    </div>
</section>
